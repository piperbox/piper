# dependencies / builds
node_modules/
dist/
build/
bin/
*.exe
# `go build ./cmd/<binary>/` with no -o drops the binary in the repo root, where
# `git add -A` will happily commit tens of MB of it. The Makefile targets write
# to bin/, so a root-level copy only ever exists by accident. Anchored so the
# cmd/ source directories of the same name are untouched.
/piper
/piperd
/piper-relay

# secrets / env
.env
.env.*
!.env.example
deploy/compose/piperd.env

# local state
*.sqlite
*.sqlite-*
*.db

# os / editor
.DS_Store
*.log

# superpowers brainstorming sessions
.superpowers/
.worktrees/

# claude code: ignore local state, keep shared project config committable.
# Must be `.claude/*`, not `.claude/` — a trailing-slash rule excludes the
# directory itself, and git never descends into it, so the `!` lines below
# would silently do nothing.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/skills/
!.claude/workflows/
