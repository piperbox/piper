# syntax=docker/dockerfile:1

# Built by goreleaser (dockers_v2: piper-relay), whose build context holds the
# prebuilt, version-stamped binaries at <os>/<arch>/piper-relay — there is no
# compile stage here, so a bare `docker build -f Dockerfile.relay .` from a
# checkout will not work. Use `goreleaser release --snapshot` instead.

# Root, not :nonroot (#554): the compose layout bind-mounts certbot's tree
# (live/ and archive/ are 0700 root, privkey 0600 root) and a 0600 root
# GitHub App key, which uid 65532 cannot read — the relay would crash-loop on
# the next version bump. On Kubernetes run it as 65532 with runAsUser +
# fsGroup and the ip_unprivileged_port_start sysctl; the runbook has the
# snippet. The image flips once the host layout has a non-root recipe.
FROM gcr.io/distroless/static-debian12
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/piper-relay /usr/local/bin/piper-relay
EXPOSE 443 80 7000 8080
ENTRYPOINT ["/usr/local/bin/piper-relay"]
